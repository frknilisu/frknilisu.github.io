---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime()),
    },
  }));
}

const { tag, posts } = Astro.props;
---

<Base title={`#${tag}`} description={`"${tag}" etiketli yazılar.`}>
  <section class="mx-auto max-w-4xl px-5 py-16 md:py-20">
    <p class="kicker mb-3">Etiket</p>
    <h1 class="font-display text-4xl md:text-5xl font-bold tracking-tight text-ink">
      #{tag}
    </h1>
    <div class="mt-5 h-1 w-14 rounded-full bg-clay"></div>
    <p class="mt-4 text-muted">{posts.length} yazı</p>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</Base>
