---
import { getCollection, render } from "astro:content";
import Base from "../layouts/Base.astro";
import SeriesBox from "../components/SeriesBox.astro";
import { formatDate, isoDate, readingTime } from "../lib/utils";

export async function getStaticPaths() {
  const posts = (await getCollection("posts")).filter((p) => !p.data.draft);
  const sorted = [...posts].sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return sorted.map((post, i) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      newer: sorted[i - 1] ?? null,
      older: sorted[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { title, description, tags, series, date, kind } = post.data;
const { Content, headings } = await render(post);
const mins = readingTime(post.body);

const isGuide = kind === "rehber";
// İçindekiler: rehberlerde ana bölümler (h2)
const toc = isGuide ? headings.filter((h) => h.depth === 2) : [];
const kicker = isGuide ? "Rehber" : series ? `Seri · ${series}` : tags[0];
---

<Base title={title} description={description}>
  <article class="mx-auto max-w-2xl px-5 pt-14 md:pt-20">
    <header>
      {
        kicker && (
          <p class="kicker mb-4">{kicker}</p>
        )
      }
      <h1
        class="font-display text-3xl md:text-[2.75rem] font-bold leading-[1.12] tracking-tight text-ink"
      >
        {title}
      </h1>

      <div
        class="mt-5 flex items-center gap-2 text-sm text-muted tabular-nums"
      >
        <time datetime={isoDate(date)}>{formatDate(date)}</time>
        <span aria-hidden="true">·</span>
        <span>{mins} dk okuma</span>
      </div>

      {
        description && (
          <p class="mt-7 border-l-2 border-clay pl-4 font-display text-lg md:text-xl italic leading-relaxed text-muted">
            {description}
          </p>
        )
      }
    </header>

    {
      toc.length > 1 && (
        <details class="toc mt-9 rounded-lg border border-line bg-paper-2/60 px-5 py-3">
          <summary class="kicker cursor-pointer select-none py-1">
            İçindekiler
          </summary>
          <ol class="mt-3 mb-1 space-y-1.5 text-[0.95rem] leading-snug">
            {toc.map((h) => (
              <li>
                <a
                  href={`#${h.slug}`}
                  class="text-body hover:text-clay-dark transition-colors"
                >
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </details>
      )
    }

    <div
      class:list={[
        "prose prose-neutral mt-10 max-w-none",
        isGuide && "prose-doc",
      ]}
    >
      <Content />
    </div>

    {series && <SeriesBox series={series} currentSlug={post.data.slug} />}

    <!-- Etiketler -->
    {
      tags.length > 0 && (
        <div class="mt-10 flex flex-wrap items-center gap-2">
          {tags.map((tag) => (
            <a
              href={`/etiket/${tag}/`}
              class="rounded-full border border-line bg-paper-2 px-3 py-1 text-sm text-clay-dark hover:border-clay/60 transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      )
    }

    <!-- Önceki / sonraki -->
    {
      (newer || older) && (
        <nav class="mt-12 grid gap-4 border-t border-line pt-8 sm:grid-cols-2">
          {older ? (
            <a href={`/${older.data.slug}/`} class="group">
              <span class="text-xs uppercase tracking-wider text-muted/80">
                Önceki
              </span>
              <span class="mt-1 block font-display font-semibold text-ink group-hover:text-clay-dark transition-colors">
                {older.data.title}
              </span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a
              href={`/${newer.data.slug}/`}
              class="group text-right sm:col-start-2"
            >
              <span class="text-xs uppercase tracking-wider text-muted/80">
                Sonraki
              </span>
              <span class="mt-1 block font-display font-semibold text-ink group-hover:text-clay-dark transition-colors">
                {newer.data.title}
              </span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Base>
