---
import type { CollectionEntry } from "astro:content";
import { formatDate, isoDate, readingTime } from "../lib/utils";

interface Props {
  post: CollectionEntry<"posts">;
}
const { post } = Astro.props;
const { title, slug, description, tags, series, date } = post.data;
const mins = readingTime(post.body);
const kicker = series ?? tags[0];
---

<article
  class="group relative flex flex-col rounded-2xl border border-line bg-white p-6 transition-all duration-200 hover:-translate-y-1 hover:border-clay/60 hover:shadow-[0_18px_40px_-24px_rgba(74,60,40,0.55)]"
>
  {
    kicker && (
      <span class="kicker mb-3">
        {series ? `Seri · ${series}` : kicker}
      </span>
    )
  }
  <h3 class="font-display text-xl font-semibold leading-snug tracking-tight text-ink">
    <a href={`/${slug}/`} class="after:absolute after:inset-0">{title}</a>
  </h3>
  {
    description && (
      <p class="mt-2.5 text-[0.97rem] leading-relaxed text-muted line-clamp-3">
        {description}
      </p>
    )
  }
  <div class="mt-5 flex items-center gap-2 text-[0.82rem] text-muted/90 tabular-nums">
    <time datetime={isoDate(date)}>{formatDate(date)}</time>
    <span aria-hidden="true">·</span>
    <span>{mins} dk okuma</span>
  </div>
</article>
